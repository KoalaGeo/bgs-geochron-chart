    skos:broader division:OX ;
    skos:definition "Actonian Substage is a substage in the British regional Ordovician stratigraphic scheme. It is the first of two substages of the Streffordian Stage. It is preceded by the Marshbrookian Substage (Cheneyan Stage) and succeeded by the Onnian Substage (BGS Research Report RR/12/04, table 1)."@en ;
    skos:notation "OT"@en ;
    skos:prefLabel "Actonian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 451.25 ] ;
