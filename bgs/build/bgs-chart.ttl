    bgsc:shortLabel "Rawtheyan"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:OA ;
    skos:definition "Rawtheyan Stage is a stage in the British regional Ordovician stratigraphic scheme. It is the third of four stages of the Ashgill Series. It is preceded by the Cautleyan Stage and succeeded by the Hirnantian Stage (Geologic Time Scale 2020, fig. 20.12)."@en ;
    skos:notation "OW"@en ;
    skos:prefLabel "Rawtheyan Stage"@en ;
    time:hasBeginning [ ischart:inMYA 448.75 ] ;
    time:hasEnd [ ischart:inMYA 445.2 ] .

