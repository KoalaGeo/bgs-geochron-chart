    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Soudleyan"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:OK ;
    skos:definition "Soudleyan Substage is a substage in the British regional Ordovician stratigraphic scheme. It is the second of three substages of the Burrellian Stage. It is preceded by the Harnagian Substage and succeeded by the Longvillian Substage (BGS Research Report RR/12/04, table 1)."@en ;
    skos:notation "OY"@en ;
    skos:prefLabel "Soudleyan Substage"@en ;
    time:hasBeginning [ ischart:inMYA 455.167 ] ;
    time:hasEnd [ ischart:inMYA 453.833 ] .

division:OZ a bgsc:RegionalUnit,
