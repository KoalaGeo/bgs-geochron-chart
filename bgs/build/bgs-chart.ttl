    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CMIE ;
    skos:definition "Tournaisian Age is a division of geological time within the Carboniferous Period. It is the only age within the Early Mississippian Epoch. It is preceded by the Famennian Age (Devonian Period) and succeeded by the Visean Age (Mid Mississippian Epoch). The Tournaisian is also the first of six stages comprising the British regional Carboniferous stratigraphic scheme, succeeded by the Visean Stage (Geologic Time Scale 2020, figs. 2.1, 23.5; https://timescalefoundation.org/)."@en ;
    skos:exactMatch ischart:Tournaisian ;
    skos:inScheme geochronology:Division ;
    skos:notation "CT"@en ;
    skos:prefLabel "Tournaisian"@en ;
    time:hasBeginning [ ischart:inMYA 359.3 ] ;
