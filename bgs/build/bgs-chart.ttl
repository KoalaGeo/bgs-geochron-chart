    skos:prefLabel "Pleistocene"@en ;
    time:hasBeginning [ ischart:inMYA 2.58 ] ;
    time:hasEnd [ ischart:inMYA 0.0118 ] ;
    sh:order 9 ;
    sdo:color "#FFEFAF" .

division:S a bgsc:ChartUnit,
        skos:Concept ;
    gts:rank <http://resource.geosciml.org/ontology/timescale/rank/Period> ;
    gts:ratifiedGSSP true ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:RZ ;
    skos:definition "Silurian Period is the third of the six periods of the Paleozoic Era. It is preceded by the Ordovician Period and succeeded by the Devonian Period (Geologic Time Scale 2020, figs. 2.1, 21.1; https://timescalefoundation.org/)."@en ;
    skos:exactMatch ischart:Silurian ;
    skos:inScheme geochronology:Division ;
