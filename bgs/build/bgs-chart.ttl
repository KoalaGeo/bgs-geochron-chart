    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:OJ ;
    skos:definition "Velfreyan Substage is a substage in the British regional Ordovician stratigraphic scheme. It is the first of two substages of the Aurelucian Stage. It is preceded by the Llandeilian Stage and succeeded by the Costonian Substage (BGS Research Report RR/12/04, table 1)."@en ;
    skos:notation "OZ"@en ;
    skos:prefLabel "Velfreyan Substage"@en ;
    time:hasBeginning [ ischart:inMYA 458.2 ] ;
    time:hasEnd [ ischart:inMYA 457.35 ] .

division:QA a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Anglian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Anglian Stage is a Mid Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Cromerian Stage and succeeded by the Hoxnian Stage. It is contemporaneous with the Elsterian Stage of NW Europe, and with Marine Isotope Stage 12 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "QA"@en ;
    skos:prefLabel "Anglian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 0.48 ] ;
    time:hasEnd [ ischart:inMYA 0.423 ] .

division:QB a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Beestonian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Beestonian Stage is an Early Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Pastonian Stage and succeeded by the Cromerian Stage. It is contemporaneous with the Eburonian to Bavelian stages of NW Europe (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). It is named for the village of Beeston, Norfolk, England."@en ;
    skos:notation "QB"@en ;
    skos:prefLabel "Beestonian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 1.78 ] ;
    time:hasEnd [ ischart:inMYA 0.86 ] .

division:QC a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Cromerian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Cromerian Stage is an Early-to-Mid Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Beestonian Stage and succeeded by the Anglian Stage. It is contemporaneous with the Cromerian Complex of NW Europe, and with marine isotope stages 13-21 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "QC"@en ;
    skos:prefLabel "Cromerian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 0.86 ] ;
    time:hasEnd [ ischart:inMYA 0.48 ] .

division:QDD a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Dimlington Stadial"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:QD ;
    skos:definition "Dimlington Stadial is a relatively cold period near the end of the Devensian Stage. It is succeeded by the Windermere Interstadial (BGS Research Report RR/10/003, table 1b; BGS British Regional Geology: Northern England (Fifth edition), fig. 64)."@en ;
    skos:notation "QDD"@en ;
    skos:prefLabel "Dimlington Stadial"@en ;
    time:hasBeginning [ ischart:inMYA 0.026 ] ;
    time:hasEnd [ ischart:inMYA 0.0147 ] .

division:QDL a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Loch Lomond Stadial (Younger Dryas)"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:QD ;
    skos:definition "Loch Lomond Stadial is a relatively cold period near the end of the Devensian Stage. It is preceded by the Windermere Interstadial (BGS Research Report RR/10/003, table 1b; BGS British Regional Geology: Northern England (Fifth edition), fig. 64)."@en ;
    skos:notation "QDL"@en ;
    skos:prefLabel "Loch Lomond Stadial (Younger Dryas)"@en ;
    time:hasBeginning [ ischart:inMYA 0.01265 ] ;
    time:hasEnd [ ischart:inMYA 0.0118 ] .

division:QDW a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Windermere Interstadial"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:QD ;
    skos:definition "Windermere Interstadial is a relatively warm period near the end of the Devensian Stage. It is preceded by the Dimlington Stadial and succeeded by the Loch Lomond Stadial (BGS Research Report RR/10/003, table 1b; BGS British Regional Geology: Northern England (Fifth edition), fig. 64)."@en ;
    skos:notation "QDW"@en ;
    skos:prefLabel "Windermere Interstadial"@en ;
    time:hasBeginning [ ischart:inMYA 0.0147 ] ;
    time:hasEnd [ ischart:inMYA 0.01265 ] .

division:QI a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Ipswichian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Ipswichian Stage is a Late Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Wolstonian Stage and succeeded by the Devensian Stage. It is contemporaneous with the Eemian Stage of NW Europe, and with Marine Isotope Stage 5e (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). It is named for the town of Ipswich, Suffolk, England."@en ;
    skos:notation "QI"@en ;
    skos:prefLabel "Ipswichian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 0.126 ] ;
    time:hasEnd [ ischart:inMYA 0.116 ] .

