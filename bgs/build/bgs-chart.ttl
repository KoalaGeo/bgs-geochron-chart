division:CV a bgsc:ChartUnit,
        skos:Concept ;
    bgsc:icsFallback "colour" ;
    gts:rank <http://resource.geosciml.org/ontology/timescale/rank/Age> ;
    gts:ratifiedGSSP true ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CMIM ;
    skos:definition "Visean Age is a division of geological time within the Carboniferous Period. It is the only age within the Mid Mississippian Epoch. It is preceded by the Tournaisian Age (Early Mississippian Epoch) and succeeded by the Serpukhovian Age (Late Mississippian Epoch). The Visean is also the second of six stages comprising the British regional Carboniferous stratigraphic scheme, preceded by the Tournaisian Stage and succeeded by the Namurian Stage (Geologic Time Scale 2020, figs. 2.1, 23.5; https://timescalefoundation.org/)."@en ;
    skos:exactMatch ischart:Visean ;
    skos:inScheme geochronology:Division ;
    skos:notation "CV"@en ;
    skos:prefLabel "Visean"@en ;
    time:hasBeginning [ ischart:inMYA 346.7 ] ;
    time:hasEnd [ ischart:inMYA 330.3 ] ;
    sh:order 103 ;
    sdo:color "#A6B96C" .

division:C a bgsc:ChartUnit,
        skos:Concept ;
    gts:rank <http://resource.geosciml.org/ontology/timescale/rank/Period> ;
    gts:ratifiedGSSP true ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:RZ ;
    skos:definition "Carboniferous Period is the fifth of the six periods of the Paleozoic Era. It is preceded by the Devonian Period and succeeded by the Permian Period (Geologic Time Scale 2020, figs. 2.1, 23.1; https://timescalefoundation.org/)."@en ;
    skos:exactMatch ischart:Carboniferous ;
    skos:inScheme geochronology:Division ;
    skos:narrower division:CMI,
        division:CPE ;
    skos:notation "C"@en ;
    skos:prefLabel "Carboniferous"@en ;
    time:hasBeginning [ ischart:inMYA 359.3 ] ;
    time:hasEnd [ ischart:inMYA 298.9 ] ;
    sh:order 104 ;
    sdo:color "#67A599" .

division:CN a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Namurian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:C ;
    skos:definition "Namurian Stage is the third of six stages of the British regional Carboniferous stratigraphic scheme. It is preceded by the Visean Stage and succeeded by the Westphalian Stage (Geologic Time Scale 2020, fig. 23.5)."@en ;
    skos:notation "CN"@en ;
    skos:prefLabel "Namurian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 330.3 ] ;
    time:hasEnd [ ischart:inMYA 319.0 ] .

