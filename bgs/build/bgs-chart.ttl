division:PLC a bgsc:ChartUnit,
        skos:Concept ;
    gts:rank <http://resource.geosciml.org/ontology/timescale/rank/Epoch> ;
    gts:ratifiedGSSP true ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:P ;
    skos:definition "Cisuralian Epoch is the first of the three epochs of the Permian Period. It is preceded by the Late Pennsylvanian Epoch (Carboniferous Period) and succeeded by the Guadalupian Epoch (Geologic Time Scale 2020, figs. 2.1, 24.1; https://timescalefoundation.org/). Replaces: Early Permian Epoch."@en ;
    skos:exactMatch ischart:Cisuralian ;
    skos:inScheme geochronology:Division ;
    skos:narrower division:PA,
        division:PI,
        division:PK,
        division:PS ;
    skos:notation "PLC"@en ;
    skos:prefLabel "Cisuralian"@en ;
    time:hasBeginning [ ischart:inMYA 298.9 ] ;
    time:hasEnd [ ischart:inMYA 274.4 ] ;
    sh:order 90 ;
    sdo:color "#EF5845" .

division:QH a bgsc:ChartUnit,
        skos:Concept ;
    gts:rank <http://resource.geosciml.org/ontology/timescale/rank/Epoch> ;
    gts:ratifiedGSSP true ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:Q ;
    skos:definition "Holocene Epoch is the second of the two epochs of the Quaternary Period. It is the epoch in which we live. It is preceded by the Pleistocene Epoch (Geologic Time Scale 2020, figs. 2.1, 30.1; https://timescalefoundation.org/). Replaces: Flandrian Age."@en ;
    skos:exactMatch ischart:Holocene ;
    skos:inScheme geochronology:Division ;
    skos:narrower division:QHE,
        division:QHL,
        division:QHM ;
    skos:notation "QH"@en ;
    skos:prefLabel "Holocene"@en ;
    time:hasBeginning [ ischart:inMYA 0.0118 ] ;
    time:hasEnd [ ischart:inMYA 0.0 ] ;
    sh:order 4 ;
    sdo:color "#FEEBD2" .

division:QP a bgsc:ChartUnit,
        skos:Concept ;
    gts:rank <http://resource.geosciml.org/ontology/timescale/rank/Epoch> ;
    gts:ratifiedGSSP true ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:Q ;
    skos:definition "Pleistocene Epoch is the first of the two epochs of the Quaternary Period. It is preceded by the Pliocene Epoch (Neogene Period) and succeeded by the Holocene Epoch (Geologic Time Scale 2020, figs. 2.1, 30.1; https://timescalefoundation.org/)."@en ;
    skos:exactMatch ischart:Pleistocene ;
    skos:inScheme geochronology:Division ;
    skos:narrower division:Q2C,
