division:QN a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Antian/Bramertonian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Antian/Bramertonian Stage is an Early Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Thurnian Stage and succeeded by the Pre-Pastonian/Baventian Stage. It is contemporaneous with Tiglian Substage C1-4b of NW Europe (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "QN"@en ;
    skos:prefLabel "Antian/Bramertonian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 2.12 ] ;
    time:hasEnd [ ischart:inMYA 2.0 ] .

division:QO a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Wolstonian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Wolstonian Stage is a Mid Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Hoxnian Stage and succeeded by the Ipswichian Stage. It is contemporaneous with the Saalian Stage of NW Europe, and with marine isotope stages 6-10 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). It is named for the village of Wolston, Warwickshire, England."@en ;
    skos:notation "QO"@en ;
    skos:prefLabel "Wolstonian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 0.362 ] ;
    time:hasEnd [ ischart:inMYA 0.126 ] .

division:QR a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Pre-Ludhamian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Pre-Ludhamian Stage is an Early Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is succeeded by the Ludhamian Stage. It is contemporaneous with Marine Isotope Stage 96 and greater (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "QR"@en ;
    skos:prefLabel "Pre-Ludhamian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 2.58 ] ;
    time:hasEnd [ ischart:inMYA 2.42 ] .

division:QS a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Pastonian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Pastonian Stage is an Early Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Pre-Pastonian/Baventian Stage and succeeded by the Beestonian Stage. It is contemporaneous with Tiglian Substage C5-6 of NW Europe (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). It is named for the village of Paston, Norfolk, England."@en ;
    skos:notation "QS"@en ;
    skos:prefLabel "Pastonian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 1.82 ] ;
    time:hasEnd [ ischart:inMYA 1.78 ] .

division:QT a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Thurnian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Thurnian Stage is an Early Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Ludhamian Stage and succeeded by the Antian/Bramertonian Stage. It is contemporaneous with Tiglian Substage B of NW Europe (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "QT"@en ;
    skos:prefLabel "Thurnian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 2.27 ] ;
    time:hasEnd [ ischart:inMYA 2.12 ] .

division:QV a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Pre-Pastonian/Baventian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Pre-Pastonian/Baventian Stage is an Early Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Antian/Bramertonian Stage and succeeded by the Pastonian Stage. It is contemporaneous with Tiglian Substage C4c of NW Europe (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). Replaces: Baventian Stage."@en ;
    skos:notation "QV"@en ;
    skos:prefLabel "Pre-Pastonian/Baventian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 2.0 ] ;
    time:hasEnd [ ischart:inMYA 1.82 ] .

division:QX a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Hoxnian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Hoxnian Stage is a Mid Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Anglian Stage and succeeded by the Wolstonian Stage. It is contemporaneous with the Holsteinian Stage of NW Europe, and with Marine Isotope Stage 11 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). It is named for the village of Hoxne, Suffolk, England."@en ;
    skos:notation "QX"@en ;
    skos:prefLabel "Hoxnian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 0.423 ] ;
    time:hasEnd [ ischart:inMYA 0.362 ] .

