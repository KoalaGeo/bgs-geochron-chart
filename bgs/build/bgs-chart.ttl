division:NM a bgsc:ChartUnit,
        skos:Concept ;
    gts:rank <http://resource.geosciml.org/ontology/timescale/rank/Epoch> ;
    gts:ratifiedGSSP true ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:N ;
    skos:definition "Miocene Epoch is the first of the two epochs of the Neogene Period. It is preceded by the Oligocene Epoch (Paleogene Period) and succeeded by the Pliocene Epoch (Geologic Time Scale 2020, figs. 2.1, 29.1; https://timescalefoundation.org/)."@en ;
