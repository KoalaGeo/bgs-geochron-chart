division:BR a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Reuverian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Reuverian Stage is a Pliocene-Early Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a temporate interval. It is succeeded by the Praetiglian Stage (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BR"@en ;
    skos:prefLabel "Reuverian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 2.7 ] ;
    time:hasEnd [ ischart:inMYA 2.52 ] .

