    skos:notation "KL"@en ;
    skos:prefLabel "Early Cretaceous"@en ;
    time:hasBeginning [ ischart:inMYA 143.1 ] ;
    time:hasEnd [ ischart:inMYA 100.5 ] ;
    sh:order 50 ;
