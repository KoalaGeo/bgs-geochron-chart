    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:OQ ;
    skos:definition "Woolstonian Substage is a substage in the British regional Ordovician stratigraphic scheme. It is the first of two substages of the Cheneyan Stage. It is preceded by the Longvillian Substage (Burrellian Stage) and succeeded by the Marshbrookian Substage (BGS Research Report RR/12/04, table 1)."@en ;
    skos:notation "OS"@en ;
    skos:prefLabel "Woolstonian Substage"@en ;
