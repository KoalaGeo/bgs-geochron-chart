        skos:Concept ;
    bgsc:column bgsc:uk-stage ;
    bgsc:shortLabel "Ludhamian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Ludhamian Stage is an Early Pleistocene stage in the British Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Pre-Ludhamian Stage and succeeded by the Thurnian Stage. It is contemporaneous with Tiglian Substage A of NW Europe (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b). It is named for the town of Ludham, England."@en ;
    skos:notation "QL"@en ;
    skos:prefLabel "Ludhamian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 2.42 ] ;
    time:hasEnd [ ischart:inMYA 2.27 ] .

