@prefix bgsc: <http://data.bgs.ac.uk/def/geochron-chart#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix division: <http://data.bgs.ac.uk/id/Geochronology/Division/> .
@prefix geochronology: <http://data.bgs.ac.uk/ref/Geochronology/> .
@prefix gts: <http://resource.geosciml.org/ontology/timescale/gts#> .
@prefix ischart: <https://data.stratigraphy.org/data/gts/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

division:BB a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Bavelian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Bavelian Stage is an Early Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is preceded by the Menapian Stage and succeeded by the Cromerian Complex. It is contemporaneous with the latest part of the Beestonian Stage in Great Britain (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BB"@en ;
    skos:prefLabel "Bavelian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 1.12 ] ;
    time:hasEnd [ ischart:inMYA 0.86 ] .

division:BC a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Cromerian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Cromerian Complex is an Early-to-Mid Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Bavelian Stage and succeeded by the Elsterian Stage. It is contemporanerous with the Cromerian Stage in Great Britain, and with marine isotope stages 13-21 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BC"@en ;
    skos:prefLabel "Cromerian Complex"@en ;
    time:hasBeginning [ ischart:inMYA 0.86 ] ;
    time:hasEnd [ ischart:inMYA 0.48 ] .

division:BD a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Weichselian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Weichselian Stage is the last Late Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Eemian Stage. It is contemporaneous with the Devensian Stage in Great Britain (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BD"@en ;
    skos:prefLabel "Weichselian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 0.116 ] ;
    time:hasEnd [ ischart:inMYA 0.0118 ] .

division:BE a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Eburonian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Eburonian Stage is an Early Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Tiglian Stage and succeeded by the Waalian Stage. It is contemporaneous with the early part of the Beestonian Stage in Great Britain (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BE"@en ;
    skos:prefLabel "Eburonian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 1.78 ] ;
    time:hasEnd [ ischart:inMYA 1.6 ] .

division:BH a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Holsteinian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Holsteinian Stage is a Mid Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Elsterian Stage and succeeded by the Saalian Stage. It is contemporaneous with the Hoxnian Stage in Great Britain, and with Marine Isotope Stage 11 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BH"@en ;
    skos:prefLabel "Holsteinian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 0.423 ] ;
    time:hasEnd [ ischart:inMYA 0.362 ] .

division:BI a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Eemian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Eemian Stage is a Late Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Saalian Stage and succeeded by the Weichselian Stage. It is contemporaneous with the Ipswichian Stage in Great Britain, and with Marine Isotope Stage 5e (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BI"@en ;
    skos:prefLabel "Eemian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 0.126 ] ;
    time:hasEnd [ ischart:inMYA 0.116 ] .

division:BL a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Elsterian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Elsterian Stage is a Mid Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Cromerian Complex and succeeded by the Holsteinian Stage. It is contemporaneous with the Anglian Stage in Great Britain, and with Marine Isotope Stage 12 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BL"@en ;
    skos:prefLabel "Elsterian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 0.48 ] ;
    time:hasEnd [ ischart:inMYA 0.423 ] .

division:BM a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Menapian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Menapian Stage is an Early Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Waalian Stage and succeeded by the Bavelian Stage. It is contemporaneous with part of the Beestonian Stage in Great Britain (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BM"@en ;
    skos:prefLabel "Menapian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 1.36 ] ;
    time:hasEnd [ ischart:inMYA 1.12 ] .

division:BP a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Praetiglian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Praetiglian Stage is an Early Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is preceded by the Reuverian Stage and succeeded by the Tiglian Stage. It is contemporaneous with marine isotope stages 96-100 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BP"@en ;
    skos:prefLabel "Praetiglian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 2.52 ] ;
    time:hasEnd [ ischart:inMYA 2.42 ] .

division:BRC a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-substage ;
    bgsc:shortLabel "Reuverian Substage C"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:BR ;
    skos:definition "Reuverian Substage C is an Early Pleistocene substage in the NW European Quaternary climatostratigraphic scheme. It is succeeded by the Praetiglian Stage (BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BRC"@en ;
    skos:prefLabel "Reuverian Substage C"@en ;
    time:hasBeginning [ ischart:inMYA 2.58 ] ;
    time:hasEnd [ ischart:inMYA 2.52 ] .

division:BS a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Saalian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Saalian Stage is a Mid Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a cold (glacial) interval. It is preceded by the Holsteinian Stage and succeeded by the Eemian Stage. It is contemporaneous with the Wolstonian Stage in Great Britain, and with marine isotope stages 6-10 (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BS"@en ;
    skos:prefLabel "Saalian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 0.362 ] ;
    time:hasEnd [ ischart:inMYA 0.126 ] .

division:BTA a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-substage ;
    bgsc:shortLabel "Tiglian Substage A"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:BT ;
    skos:definition "Tiglian Substage A is an Early Pleistocene substage in the NW European Quaternary climatostratigraphic scheme. It is the first of three substages within the Tiglian Stage. It is succeeded by Tiglian Substage B. It is contemporaneous with the Ludhamian Stage in Great Britain (BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BTA"@en ;
    skos:prefLabel "Tiglian Substage A"@en ;
    time:hasBeginning [ ischart:inMYA 2.42 ] ;
    time:hasEnd [ ischart:inMYA 2.27 ] .

division:BTB a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-substage ;
    bgsc:shortLabel "Tiglian Substage B"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:BT ;
    skos:definition "Tiglian Substage B is an Early Pleistocene substage in the NW European Quaternary climatostratigraphic scheme. It is the second of three substages within the Tiglian Stage. It is preceded by Tiglian Substage A, and succeeded by Tiglian Substage C. It is contemporaneous with the Thurnian Stage in Great Britain (BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BTB"@en ;
    skos:prefLabel "Tiglian Substage B"@en ;
    time:hasBeginning [ ischart:inMYA 2.27 ] ;
    time:hasEnd [ ischart:inMYA 2.12 ] .

division:BTC a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-substage ;
    bgsc:shortLabel "Tiglian Substage C"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:BT ;
    skos:definition "Tiglian Substage C is an Early Pleistocene substage in the NW European Quaternary climatostratigraphic scheme. It is the last of three substages within the Tiglian Stage. It is preceded by Tiglian Substage B. It is contemporaneous with the Antian/Bramertonian-to-Pastonian stages in Great Britain (BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BTC"@en ;
    skos:prefLabel "Tiglian Substage C"@en ;
    time:hasBeginning [ ischart:inMYA 2.12 ] ;
    time:hasEnd [ ischart:inMYA 1.78 ] .

division:BW a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:nw-europe-stage ;
    bgsc:shortLabel "Waalian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:definition "Waalian Stage is an Early Pleistocene stage in the NW European Quaternary climatostratigraphic scheme. It is interpreted as a temporate (interglacial) interval. It is preceded by the Eburonian Stage and succeeded by the Menapian Stage. It is contemporaneous with part of the Beestonian Stage in Great Britain (Geologic Time Scale 2020, fig. 30.2; BGS Research Report RR/10/003, table 1b)."@en ;
    skos:notation "BW"@en ;
    skos:prefLabel "Waalian Stage"@en ;
    time:hasBeginning [ ischart:inMYA 1.6 ] ;
    time:hasEnd [ ischart:inMYA 1.36 ] .

division:CA a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Langsettian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CW ;
    skos:definition "Langsettian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the first of four substages of the Westphalian Stage. It is preceded by the Yeadonian Substage (Namurian Stage) and succeeded by the Duckmantian Substage (Geologic Time Scale 2020, fig. 23.5). Replaces: Westphalian Substage A."@en ;
    skos:notation "CA"@en ;
    skos:prefLabel "Langsettian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 319.0 ] ;
    time:hasEnd [ ischart:inMYA 318.0 ] .

division:CAS a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Asturian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CW ;
    skos:definition "Asturian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the last of four substages of the Westphalian Stage. It is preceded by the Bolsovian Substage and succeeded by the Cantabrian Substage (Stephanian Stage) (Geologic Time Scale 2020, fig. 23.5). Replaces: Westphalian Substage D."@en ;
    skos:notation "CAS"@en ;
    skos:prefLabel "Asturian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 310.0 ] ;
    time:hasEnd [ ischart:inMYA 307.5 ] .

division:CB a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Duckmantian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CW ;
    skos:definition "Duckmantian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the second of four substages of the Westphalian Stage. It is preceded by the Langsettian Substage and succeeded by the Bolsovian Substage (Geologic Time Scale 2020, fig. 23.5). Replaces: Westphalian Substage B."@en ;
    skos:notation "CB"@en ;
    skos:prefLabel "Duckmantian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 318.0 ] ;
    time:hasEnd [ ischart:inMYA 314.75 ] .

division:CC a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Bolsovian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CW ;
    skos:definition "Bolsovian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the third of four substages of the Westphalian Stage. It is preceded by the Duckmantian Substage and succeeded by the Asturian Substage (Geologic Time Scale 2020, fig. 23.5). Replaces: Westphalian Substage C."@en ;
    skos:notation "CC"@en ;
    skos:prefLabel "Bolsovian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 314.75 ] ;
    time:hasEnd [ ischart:inMYA 310.0 ] .

division:CE a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Pendleian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CN ;
    skos:definition "Pendleian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the first of seven substages of the Namurian Stage. It is preceded by the Brigantian Substage (Visean Stage) and succeeded by the Arnsbergian Substage (Geologic Time Scale 2020, fig. 23.5)."@en ;
    skos:notation "CE"@en ;
    skos:prefLabel "Pendleian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 330.3 ] ;
    time:hasEnd [ ischart:inMYA 327.0 ] .

division:CF a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Courceyan"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CT ;
    skos:definition "Courceyan Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the only substage of the Tournaisian Stage. It is succeeded by the Chadian Substage (Visean Stage) (BGS Research Report RR/10/07, table 1)."@en ;
    skos:notation "CF"@en ;
    skos:prefLabel "Courceyan Substage"@en ;
    time:hasBeginning [ ischart:inMYA 359.3 ] ;
    time:hasEnd [ ischart:inMYA 346.7 ] ;
    sdo:color "#80AB6C" .

division:CG a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Arnsbergian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CN ;
    skos:definition "Arnsbergian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the second of seven substages of the Namurian Stage. It is preceded by the Pendleian Substage and succeeded by the Chokierian Substage (Geologic Time Scale 2020, fig. 23.5)."@en ;
    skos:notation "CG"@en ;
    skos:prefLabel "Arnsbergian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 327.0 ] ;
    time:hasEnd [ ischart:inMYA 323.75 ] .

division:CH a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Chokierian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CN ;
    skos:definition "Chokierian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the third of seven substages of the Namurian Stage. It is preceded by the Arnsbergian Substage and succeeded by the Alportian Substage (Geologic Time Scale 2020, fig. 23.5)."@en ;
    skos:notation "CH"@en ;
    skos:prefLabel "Chokierian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 323.75 ] ;
    time:hasEnd [ ischart:inMYA 323.0 ] .

division:CI a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Chadian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CV ;
    skos:definition "Chadian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the first of five substages of the Visean Stage. It is preceded by the Courceyan Substage (Tournaisian Stage) and succeeded by the Arundian Substage (BGS Research Report RR/10/07, table 1)."@en ;
    skos:notation "CI"@en ;
    skos:prefLabel "Chadian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 346.7 ] ;
    time:hasEnd [ ischart:inMYA 344.5 ] .

division:CJ a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Arundian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CV ;
    skos:definition "Arundian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the second of five substages of the Visean Stage. It is preceded by the Chadian Substage and succeeded by the Holkerian Substage (BGS Research Report RR/10/07, table 1)."@en ;
    skos:notation "CJ"@en ;
    skos:prefLabel "Arundian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 344.5 ] ;
    time:hasEnd [ ischart:inMYA 343.0 ] .

division:CK a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Kinderscoutian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CN ;
    skos:definition "Kinderscoutian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the fifth of seven substages of the Namurian Stage. It is preceded by the Alportian Substage and succeeded by the Marsdenian Substage (Geologic Time Scale 2020, fig. 23.5)."@en ;
    skos:notation "CK"@en ;
    skos:prefLabel "Kinderscoutian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 322.0 ] ;
    time:hasEnd [ ischart:inMYA 321.5 ] .

division:CO a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Alportian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CN ;
    skos:definition "Alportian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the fourth of seven substages of the Namurian Stage. It is preceded by the Chokierian Substage and succeeded by the Kinderscoutian Substage (Geologic Time Scale 2020, fig. 23.5)."@en ;
    skos:notation "CO"@en ;
    skos:prefLabel "Alportian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 323.0 ] ;
    time:hasEnd [ ischart:inMYA 322.0 ] .

division:CQ a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Holkerian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CV ;
    skos:definition "Holkerian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the third of five substages of the Visean Stage. It is preceded by the Arundian Substage and succeeded by the Asbian Substage (BGS Research Report RR/10/07, table 1)."@en ;
    skos:notation "CQ"@en ;
    skos:prefLabel "Holkerian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 343.0 ] ;
    time:hasEnd [ ischart:inMYA 337.0 ] .

division:CR a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Asbian"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CV ;
    skos:definition "Asbian Substage is a substage in the British regional Carboniferous stratigraphic scheme. It is the fourth of five substages of the Visean Stage. It is preceded by the Holkerian Substage and succeeded by the Brigantian Substage (BGS Research Report RR/10/07, table 1)."@en ;
    skos:notation "CR"@en ;
    skos:prefLabel "Asbian Substage"@en ;
    time:hasBeginning [ ischart:inMYA 337.0 ] ;
    time:hasEnd [ ischart:inMYA 330.9 ] .

division:CSA a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Stephanian Substage A"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CS ;
    skos:definition "Stephanian Substage A is a substage in the British regional Carboniferous stratigraphic scheme. It is the second of four substages of the Stephanian Stage. It is preceded by the Cantabrian Substage and succeeded by Stephanian Substage B (Geologic Time Scale 2020, fig. 23.5)."@en ;
    skos:notation "CSA"@en ;
    skos:prefLabel "Stephanian Substage A"@en ;
    time:hasBeginning [ ischart:inMYA 305.0 ] ;
    time:hasEnd [ ischart:inMYA 301.5 ] .

division:CSB a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Stephanian Substage B"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CS ;
    skos:definition "Stephanian Substage B is a substage in the British regional Carboniferous stratigraphic scheme. It is the third of four substages of the Stephanian Stage. It is preceded by Stephanian Substage A and succeeded by Stephanian Substage C (Geologic Time Scale 2020, fig. 23.5)."@en ;
    skos:notation "CSB"@en ;
    skos:prefLabel "Stephanian Substage B"@en ;
    time:hasBeginning [ ischart:inMYA 301.5 ] ;
    time:hasEnd [ ischart:inMYA 301.0 ] .

division:CSC a bgsc:RegionalUnit,
        skos:Concept ;
    bgsc:column bgsc:uk-substage ;
    bgsc:shortLabel "Stephanian Substage C"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:CS ;
    skos:definition "Stephanian Substage C is a substage in the British regional Carboniferous stratigraphic scheme. It is the last of four substages of the Stephanian Stage. It is preceded by Stephanian Substage B and succeeded by the Autunian Stage (Geologic Time Scale 2020, fig. 23.5)."@en ;
    skos:notation "CSC"@en ;
    skos:prefLabel "Stephanian Substage C"@en ;
    time:hasBeginning [ ischart:inMYA 301.0 ] ;
