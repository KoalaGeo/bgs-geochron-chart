division:KU a bgsc:ChartUnit,
        skos:Concept ;
    bgsc:stratigraphicLabel "Upper Cretaceous"@en ;
    gts:rank <http://resource.geosciml.org/ontology/timescale/rank/Epoch> ;
    gts:ratifiedGSSP true ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:K ;
    skos:definition "Late Cretaceous Epoch is the second of the two epochs of the Cretaceous Period. It is preceded by the Early Cretaceous Epoch and succeeded by the Paleocene Epoch (Paleogene Period) (Geologic Time Scale 2020, figs. 2.1, 27.1; https://timescalefoundation.org/)."@en ;
    skos:exactMatch ischart:UpperCretaceous ;
    skos:inScheme geochronology:Division ;
    skos:narrower division:KC,
