    bgsc:shortLabel "Cautleyan"@en ;
    rdfs:isDefinedBy geochronology:Division ;
    skos:broader division:OA ;
    skos:definition "Cautleyan Stage is a stage in the British regional Ordovician stratigraphic scheme. It is the second of four stages of the Ashgill Series. It is preceded by the Pusgillian Stage and succeeded by the Rawtheyan Stage (Geologic Time Scale 2020, fig. 20.12)."@en ;
    skos:notation "OU"@en ;
    skos:prefLabel "Cautleyan Stage"@en ;
    time:hasBeginning [ ischart:inMYA 449.25 ] ;
